{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/py/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/fastapi/:path*",
      "destination": "/api/index.py"
    }
  ]
}
